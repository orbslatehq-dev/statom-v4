# ── Statom V4 Environment Variables ──
# Copy this file to .env and fill in your own keys. Never commit .env

# Groq API key for AI Solar Advisor (optional — app works fully offline without it)
# Get a free key at https://console.groq.com/keys
# The advisor uses openai/gpt-oss-20b with 120b fallback
VITE_GROQ_API_KEY=

# Optional: override API endpoints (defaults are in src/ai/groqConfig.ts & vite.config.ts)
# VITE_GROQ_CHAT_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
